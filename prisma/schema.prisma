generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Session {
  MORNING
  EVENING
}

enum Drink {
  CHAI
  COFFEE
  MILK
}

enum SugarLevel {
  NO_SUGAR
  LITTLE_SUGAR
  NORMAL
}

enum MilkOption {
  REGULAR
  NO_MILK
  OAT_MILK
}

model User {
  id        String  @id @default(cuid())
  name      String
  email     String  @unique
  role      Role    @default(USER)
  createdAt DateTime @default(now())
  entries   Entry[]
}

model Entry {
  id          String     @id @default(cuid())
  user        User       @relation(fields: [userId], references: [id])
  userId      String
  session     Session
  drink       Drink
  sugar       SugarLevel
  milk        MilkOption
  tookSnacks  Boolean    @default(false)
  snackCount  Int        @default(0)
  loggedFor   DateTime
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
